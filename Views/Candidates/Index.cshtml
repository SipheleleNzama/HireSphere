@model IEnumerable<Candidate>

@{
    ViewData["Title"] = "Candidates";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-users me-2"></i>@ViewData["Title"]</h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus me-1"></i> Add New Candidate
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <form asp-action="Index" method="get" class="form-inline">
                <div class="input-group">
                    <input type="text" class="form-control" name="searchString" value="@ViewData["CurrentFilter"]" placeholder="Search candidates...">
                    <button class="btn btn-outline-primary" type="submit">
                        <i class="fas fa-search"></i>
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>
                                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParm"]">
                                    Name <i class="fas fa-sort"></i>
                                </a>
                            </th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>Skills</th>
                            <th>
                                <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParm"]">
                                    Last Applied <i class="fas fa-sort"></i>
                                </a>
                            </th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-action="View" asp-route-id="@item.Id">
                                        @item.FirstName @item.LastName
                                    </a>
                                </td>
                                <td>@item.Email</td>
                                <td>@item.Phone</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Skills))
                                    {
                                        var skills = item.Skills.Split(',').Take(3);
                                        <span>@string.Join(", ", skills)</span>
                                        @if (item.Skills.Split(',').Length > 3)
                                        {
                                            <span>...</span>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (item.Applications?.Any() == true)
                                    {
                                        @item.Applications.Max(a => a.ApplicationDate).ToString("MMM dd, yyyy")
                                    }
                                    else
                                    {
                                        <span>Never</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="View" asp-route-id="@item.Id" class="btn btn-outline-primary" title="View">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-secondary" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="@item.ResumePath" target="_blank" class="btn btn-outline-info @(string.IsNullOrEmpty(item.ResumePath) ? "disabled" : "")" title="Download Resume">
                                            <i class="fas fa-file-download"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>