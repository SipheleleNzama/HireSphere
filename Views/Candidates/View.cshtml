@model Candidate

@{
    ViewData["Title"] = "Candidate Details";
    var resumeAnalysis = ViewBag.ResumeAnalysis as Dictionary<string, string>;
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h2 class="mb-0"><i class="fas fa-user me-2"></i>@ViewData["Title"]</h2>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light btn-sm me-2">
                                <i class="fas fa-edit me-1"></i> Edit
                            </a>
                            <a asp-action="Index" class="btn btn-light btn-sm">
                                <i class="fas fa-arrow-left me-1"></i> Back
                            </a>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-4 text-center">
                            <div class="avatar-placeholder mb-3" style="width: 150px; height: 150px; background-color: #f0f0f0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto;">
                                <i class="fas fa-user fa-4x text-secondary"></i>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.ResumePath))
                            {
                                <a href="@Model.ResumePath" target="_blank" class="btn btn-primary">
                                    <i class="fas fa-file-download me-1"></i> Download Resume
                                </a>
                            }
                        </div>
                        <div class="col-md-8">
                            <h3>@Model.FirstName @Model.LastName</h3>
                            <hr />
                            <dl class="row">
                                <dt class="col-sm-4">Email</dt>
                                <dd class="col-sm-8">@Model.Email</dd>

                                <dt class="col-sm-4">Phone</dt>
                                <dd class="col-sm-8">@Model.Phone</dd>

                                <dt class="col-sm-4">Expected Salary</dt>
                                <dd class="col-sm-8"> @string.Format("R{0:N0}", Model.ExpectedSalary)</dd>

                                <dt class="col-sm-4">Skills</dt>
                                <dd class="col-sm-8">
                                    @if (!string.IsNullOrEmpty(Model.Skills))
                                    {
                                        foreach (var skill in Model.Skills.Split(','))
                                        {
                                            <span class="badge bg-primary me-1 mb-1">@skill.Trim()</span>
                                        }
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>

                    @if (resumeAnalysis != null)
                    {
                        <div class="mb-4">
                            <h4><i class="fas fa-brain me-2"></i>AI Resume Analysis</h4>
                            <div class="row">
                                @foreach (var item in resumeAnalysis)
                                {
                                    <div class="col-md-6 mb-3">
                                        <div class="card h-100">
                                            <div class="card-body">
                                                <h5 class="card-title">@item.Key</h5>
                                                <p class="card-text">@item.Value</p>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="applications-section">
                        <h4><i class="fas fa-briefcase me-2"></i>Job Applications</h4>
                        @if (Model.Applications?.Any() == true)
                        {
                            <div class="table-responsive">
                                <table class="table table-hover">
                                    <thead>
                                        <tr>
                                            <th>Job Title</th>
                                            <th>Applied Date</th>
                                            <th>Status</th>
                                            <th>Match Score</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var application in Model.Applications.OrderByDescending(a => a.ApplicationDate))
                                        {
                                            <tr>
                                                <td>
                                                    <a asp-controller="JobPostings" asp-action="Details" asp-route-id="@application.JobPostingId">
                                                        @application.JobPosting?.Title
                                                    </a>
                                                </td>
                                                <td>@application.ApplicationDate.ToString("MMM dd, yyyy")</td>
                                                <td>
                                                    <span class="badge @GetStatusBadgeClass(application.Status)">
                                                        @application.Status
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="progress" style="height: 20px;">
                                                        <div class="progress-bar @GetMatchScoreClass(application.MatchScore)"
                                                             role="progressbar"
                                                             style="width: @application.MatchScore%"
                                                             aria-valuenow="@application.MatchScore"
                                                             aria-valuemin="0"
                                                             aria-valuemax="100">
                                                            @application.MatchScore.ToString("0")%
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">
                                This candidate hasn't applied to any jobs yet.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0"><i class="fas fa-chart-pie me-2"></i>Quick Stats</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <h6>Applications</h6>
                        <div class="d-flex justify-content-between">
                            <span>Total:</span>
                            <strong>@Model.Applications?.Count ?? 0</strong>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Average Match:</span>
                            <strong>
                                @(Model.Applications?.Any() == true ?
                                    Model.Applications.Average(a => a.MatchScore).ToString("0") + "%" : "N/A")
                            </strong>
                        </div>
                    </div>
                    <hr />
                    <div class="mb-3">
                        <h6>Skills Analysis</h6>
                        @if (!string.IsNullOrEmpty(Model.Skills))
                        {
                            var topSkills = Model.Skills.Split(',')
                            .Take(5)
                            .Select(s => s.Trim());

                            <ul class="list-unstyled">
                                @foreach (var skill in topSkills)
                                {
                                    <li>
                                        <i class="fas fa-check-circle text-success me-2"></i> @skill
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted">No skills listed</p>
                        }
                    </div>
                    <hr />
                    <div>
                        <h6>Actions</h6>
                        <div class="d-grid gap-2">
                            <a href="#" class="btn btn-outline-primary btn-sm">
                                <i class="fas fa-envelope me-1"></i> Send Message
                            </a>
                            <a href="#" class="btn btn-outline-success btn-sm">
                                <i class="fas fa-calendar-check me-1"></i> Schedule Interview
                            </a>
                            <a href="#" class="btn btn-outline-info btn-sm">
                                <i class="fas fa-tag me-1"></i> Add to Talent Pool
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetStatusBadgeClass(ApplicationStatus? status)
    {
		if (!status.HasValue) return "bg-secondary";

        return status.Value switch
        {
            ApplicationStatus.Submitted => "bg-secondary",
            ApplicationStatus.UnderReview => "bg-info",
            ApplicationStatus.Interviewing => "bg-primary",
            ApplicationStatus.Offered => "bg-success",
            ApplicationStatus.Rejected => "bg-danger",
            _ => "bg-secondary",
        };
    }

    public string GetMatchScoreClass(decimal score)
    {
        return score switch
        {
            >= 80 => "bg-success",
            >= 50 => "bg-warning",
            _ => "bg-danger",
        };
    }
}