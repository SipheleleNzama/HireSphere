@model HireSphere.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-container">
    <h2 class="dashboard-header">
        <i class="fas fa-tachometer-alt"></i> HireSphere Dashboard
    </h2>

    <div class="row mb-4">
        <div class="col-md-3">
            <div class="stats-card bg-primary text-white">
                <div class="stats-icon">
                    <i class="fas fa-briefcase"></i>
                </div>
                <div class="stats-content">
                    <h3>@Model.TotalJobs</h3>
                    <p>Total Jobs</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card bg-success text-white">
                <div class="stats-icon">
                    <i class="fas fa-check-circle"></i>
                </div>
                <div class="stats-content">
                    <h3>@Model.ActiveJobs</h3>
                    <p>Active Jobs</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card bg-info text-white">
                <div class="stats-icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="stats-content">
                    <h3>@Model.TotalCandidates</h3>
                    <p>Candidates</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card bg-warning text-white">
                <div class="stats-icon">
                    <i class="fas fa-file-alt"></i>
                </div>
                <div class="stats-content">
                    <h3>@Model.TotalApplications</h3>
                    <p>Applications</p>
                </div>
            </div>
        </div>
    </div>
<style>
    .dashboard-container {
        padding: 20px;
        background: #f8f9fa;
        min-height: calc(100vh - 150px);
    }

    .dashboard-header {
        color: #2c3e50;
        margin-bottom: 30px;
        padding-bottom: 15px;
        border-bottom: 1px solid #eee;
    }

    .stats-card {
        border-radius: 10px;
        padding: 20px;
        display: flex;
        align-items: center;
        transition: all 0.3s;
        cursor: pointer;
        height: 100%;
    }

     .stats-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

    .stats-icon {
        font-size: 2.5rem;
        margin-right: 20px;
        opacity: 0.8;
    }

    .stats-content h3 {
        font-size: 2rem;
        margin-bottom: 5px;
    }

    .stats-content p {
        opacity: 0.8;
        margin-bottom: 0;
    }

    .bg-primary { background: #3498db; }
    .bg-success { background: #2ecc71; }
    .bg-info { background: #1abc9c; }
    .bg-warning { background: #f39c12; }
</style>

<!-- Add Font Awesome for icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">