@{
    ViewData["Title"] = "Welcome to HireSphere";
}

<div class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="display-4">Find Your Perfect Candidate</h1>
                <p class="lead">AI-powered recruitment platform that simplifies your hiring process</p>
                <div class="cta-buttons">
                    <a class="btn btn-primary btn-lg" asp-controller="JobPostings" asp-action="Index">
                        <i class="fas fa-briefcase"></i> View Jobs
                    </a>
                    <a class="btn btn-outline-secondary btn-lg" asp-controller="Dashboard" asp-action="Index">
                        <i class="fas fa-tachometer-alt"></i> Go to Dashboard
                    </a>
                </div>
            </div>
            <div class="col-md-6">
                <img src="~/images/hiring-illustration.png" alt="Hiring Illustration" class="img-fluid">
            </div>
        </div>
    </div>
</div>

<div class="features-section py-5">
    <div class="container">
        <h2 class="text-center mb-5">Why Choose HireSphere?</h2>
        <div class="row">
            <div class="col-md-4 feature-card">
                <div class="feature-icon">
                    <i class="fas fa-robot"></i>
                </div>
                <h3>AI-Powered Matching</h3>
                <p>Our advanced algorithms match candidates to jobs with 95% accuracy.</p>
            </div>
            <div class="col-md-4 feature-card">
                <div class="feature-icon">
                    <i class="fas fa-bolt"></i>
                </div>
                <h3>Fast Hiring</h3>
                <p>Reduce your hiring time from weeks to just days.</p>
            </div>
            <div class="col-md-4 feature-card">
                <div class="feature-icon">
                    <i class="fas fa-chart-line"></i>
                </div>
                <h3>Data-Driven Insights</h3>
                <p>Get actionable analytics to improve your hiring process.</p>
            </div>
        </div>
    </div>
</div>

<style>
    .hero-section {
        padding: 100px 0;
        background: linear-gradient(135deg, #3498db, #2c3e50);
        color: white;
    }

        .hero-section h1 {
            font-weight: 700;
            margin-bottom: 20px;
        }

        .hero-section p {
            font-size: 1.2rem;
            margin-bottom: 30px;
        }

    .cta-buttons {
        display: flex;
        gap: 15px;
    }

    .features-section {
        background: white;
    }

    .feature-card {
        text-align: center;
        padding: 30px 20px;
        border-radius: 8px;
        transition: transform 0.3s;
    }

        .feature-card:hover {
            transform: translateY(-10px);
        }

    .feature-icon {
        font-size: 3rem;
        color: #3498db;
        margin-bottom: 20px;
    }

    .feature-card h3 {
        margin: 15px 0;
    }
</style>