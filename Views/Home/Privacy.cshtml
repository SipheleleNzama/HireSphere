@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-3">
            <div class="list-group">
                <a href="#privacy" class="list-group-item list-group-item-action active">Privacy Policy</a>
                <a href="#terms" class="list-group-item list-group-item-action">Terms of Service</a>
                <a href="#cookies" class="list-group-item list-group-item-action">Cookie Policy</a>
            </div>
        </div>

        <div class="col-md-9">
            <!-- Privacy Policy Section -->
            <section id="privacy" class="mb-5">
                <h2 class="mb-4">Privacy Policy</h2>
                <p>Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>

                <h4>1. Information We Collect</h4>
                <p>We collect information you provide directly to us, including when you create an account, submit applications, or contact us.</p>

                <h4>2. How We Use Your Information</h4>
                <p>We use the information we collect to provide and improve our services, communicate with you, and ensure platform security.</p>

                <!-- Add more privacy policy content as needed -->
            </section>

            <!-- Terms of Service Section -->
            <section id="terms" class="mb-5">
                <h2 class="mb-4">Terms of Service</h2>
                <p>Effective: @DateTime.Now.ToString("MMMM dd, yyyy")</p>

                <h4>1. Acceptance of Terms</h4>
                <p>By accessing or using HireSphere, you agree to be bound by these Terms of Service.</p>

                <h4>2. User Responsibilities</h4>
                <p>You agree to provide accurate information and not to misuse the platform or its services.</p>

                <!-- Add more terms content as needed -->
            </section>

            <!-- Cookie Policy Section -->
            <section id="cookies">
                <h2 class="mb-4">Cookie Policy</h2>
                <p>Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")</p>

                <h4>1. What Are Cookies</h4>
                <p>Cookies are small text files stored on your device when you visit our website.</p>

                <h4>2. How We Use Cookies</h4>
                <p>We use cookies to remember your preferences, analyze traffic, and improve user experience.</p>

                <!-- Add more cookie policy content as needed -->
            </section>
        </div>
    </div>
</div>

<style>
    .list-group-item.active {
        background-color: #3498db;
        border-color: #3498db;
    }

    section {
        scroll-margin-top: 80px; /* Account for fixed header */
    }
</style>

<script>
    // Highlight current section in sidebar when scrolling
    document.addEventListener('DOMContentLoaded', function() {
        const sections = document.querySelectorAll('section');
        const navItems = document.querySelectorAll('.list-group-item');

        window.addEventListener('scroll', function() {
            let current = '';

            sections.forEach(section => {
                const sectionTop = section.offsetTop;
                if (pageYOffset >= sectionTop - 100) {
                    current = section.getAttribute('id');
                }
            });

            navItems.forEach(item => {
                item.classList.remove('active');
                if (item.getAttribute('href') === '#' + current) {
                    item.classList.add('active');
                }
            });
        });
    });
</script>