@model JobPosting

@{
    ViewData["Title"] = "Job Details";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h2 class="mb-0"><i class="fas fa-briefcase me-2"></i>@Model.Title</h2>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Location:</dt>
                <dd class="col-sm-9">@Model.Location</dd>

                <dt class="col-sm-3">Salary Range:</dt>
                <dd class="col-sm-9">@Model.SalaryRangeMin.ToString("C0") - @Model.SalaryRangeMax.ToString("C0")</dd>

                <dt class="col-sm-3">Posted Date:</dt>
                <dd class="col-sm-9">@Model.PostedDate.ToString("MMM dd, yyyy")</dd>

                <dt class="col-sm-3">Expiry Date:</dt>
                <dd class="col-sm-9">@Model.ExpiryDate.ToString("MMM dd, yyyy")</dd>

                <dt class="col-sm-3">Status:</dt>
                <dd class="col-sm-9">
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                        @(Model.IsActive ? "Active" : "Closed")
                    </span>
                </dd>

                <dt class="col-sm-3">Description:</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Requirements:</dt>
                <dd class="col-sm-9">@Model.Requirements</dd>
            </dl>
        </div>
        <div class="card-footer">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back to List
            </a>
        </div> 
        <div class="mt-4">
            <a asp-controller="Applications" asp-action="Create" asp-route-jobId="@Model.Id"
               class="btn btn-primary btn-lg">
                <i class="fas fa-file-alt me-2"></i>Apply Now
            </a>
        </div>
    </div>
</div>