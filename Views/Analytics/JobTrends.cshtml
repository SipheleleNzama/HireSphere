
@model List<HireSphere.Models.ViewModels.JobTrendViewModel>

<h2>Job Posting Trends</h2>

<table class="table">
    <thead>
        <tr>
            <th>Date</th>
            <th>Jobs Posted</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var trend in Model)
        {
            <tr>
                <td>@trend.Date.ToShortDateString()</td>
                <td>@trend.Count</td>
            </tr>
        }
    </tbody>
</table>