@model HireSphere.Models.ViewModels.AnalyticsDashboardViewModel

<h2>Analytics Dashboard</h2>

<div class="row">
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Total Jobs</h5>
                <p class="card-text display-4">@Model.TotalJobs</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Total Candidates</h5>
                <p class="card-text display-4">@Model.TotalCandidates</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Total Applications</h5>
                <p class="card-text display-4">@Model.TotalApplications</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Avg Match Score</h5>
                <p class="card-text display-4">@Model.AverageMatchScore.ToString("0.00")</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-action="JobTrends" class="btn btn-primary">View Job Trends</a>
    <a asp-action="CandidateAnalysis" class="btn btn-secondary">Candidate Analysis</a>
    @if (User.IsInRole("Administrator"))
    {
        <a asp-action="SystemMetrics" class="btn btn-info">System Metrics</a>
    }
</div>